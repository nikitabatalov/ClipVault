<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClipVault.Models"
        Title="ClipVault — by Nikita Batalov" Icon="Assets/ClipVault.ico"
        Width="1320" Height="835" MinWidth="1010" MinHeight="665"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="SideNav" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#B2B3BC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#25262D"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#131419" BorderBrush="#282930" BorderThickness="0,0,1,0" Padding="18,24,18,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,1,0,43">
                        <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="12" Margin="0,0,12,0">
                            <TextBlock Text="▶" Foreground="#16171B" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ClipVault" FontWeight="Bold" FontSize="19"/>
                            <TextBlock Text="YOUR MOMENTS. SAVED." Foreground="#F47B3A" FontWeight="SemiBold" FontSize="8"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#777985" FontSize="10" FontWeight="Bold" Margin="15,0,0,15"/>
                    <Button x:Name="LibraryNav" Style="{StaticResource SideNav}" Click="LibraryNav_Click" Background="#33241D" Foreground="White" Content="▣     Библиотека"/>
                    <Button x:Name="RulesNav" Style="{StaticResource SideNav}" Click="RulesNav_Click" Content="▤     Игры и папки"/>
                    <Button x:Name="FriendsNav" Style="{StaticResource SideNav}" Click="FriendsNav_Click" Content="♧     Друзья"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource SideNav}" Click="SettingsNav_Click" Content="⚙     Настройки"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#242126" CornerRadius="11" Padding="13" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="✦  БИБЛИОТЕКА НА ПК" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                            <TextBlock Text="Все клипы хранятся локально. Без облака и подписок." TextWrapping="Wrap" Foreground="#B6B5BD" FontSize="11" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#32333B" BorderThickness="0,1,0,0" Padding="3,15,0,0">
                        <StackPanel>
                            <TextBlock Text="ClipVault" Foreground="#F6F6F7" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="by Nikita Batalov" Foreground="#A0A0A8" FontSize="11" Margin="0,3,0,0"/>
                            <TextBlock Text="BETA 0.1.3  /  WINDOWS" Foreground="#747580" FontSize="9" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="29,24,29,19">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Библиотека моментов" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Все твои лучшие моменты — в одном месте" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlainButton}" Content="↻  Обновить" Margin="0,0,9,0" Click="Refresh_Click"/>
                    <Button Style="{StaticResource OrangeButton}" Content="＋  Добавить видео" Click="Import_Click"/>
                </StackPanel>
            </Grid>
            <!-- LIBRARY -->
            <Grid x:Name="LibraryPage" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="SetupBanner" Grid.Row="0" Background="#35231C" BorderBrush="#6C422D" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,15">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource OrangeButton}" Content="Выбрать папку" Click="ChooseRoot_Click" Margin="18,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="✦  Первый запуск — выбери папку для клипов" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Выбери диск F:\ или другую папку — ClipVault сам создаст вложенную папку ClipVault с играми и категориями." FontSize="12" Foreground="#DAC0AE" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel><TextBlock Text="ВСЕГО ВИДЕО" Style="{StaticResource Caption}"/><TextBlock x:Name="ClipTotal" Text="0" FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel><TextBlock Text="ИГР В БИБЛИОТЕКЕ" Style="{StaticResource Caption}"/><TextBlock x:Name="GamesTotal" Text="0" FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel><TextBlock Text="С МЕТКАМИ" Style="{StaticResource Caption}"/><TextBlock x:Name="TaggedTotal" Text="0" FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel><TextBlock Text="ДРУЗЕЙ" Style="{StaticResource Caption}"/><TextBlock x:Name="FriendsTotal" Text="0" FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="125"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Tag="⌕  Поиск видео, игр, друзей..." Grid.Column="0" TextChanged="Filters_Changed" Margin="0,0,8,0" ToolTip="Поиск по названию, игре, категории или другу"/>
                    <ComboBox x:Name="GameFilter" Grid.Column="1" SelectionChanged="GameFilter_Changed" Margin="0,0,8,0"/>
                    <ComboBox x:Name="IconFilter" Grid.Column="2" SelectionChanged="Filters_Changed" Margin="0,0,8,0"/>
                    <ComboBox x:Name="FriendFilter" Grid.Column="3" SelectionChanged="Filters_Changed" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ColorFilter" Grid.Column="4" SelectionChanged="Filters_Changed"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="193"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Padding="10,15" Margin="0,0,17,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ" Foreground="#9395A1" FontSize="10" FontWeight="Bold" Margin="11,0,0,13"/>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource PlainButton}" Content="＋  Изменить папки" Click="RulesNav_Click" Margin="2,12,2,0" Padding="9" FontSize="11"/>
                            <ListBox x:Name="CategoryFilter" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryFilter_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><Border Background="#212228" CornerRadius="7" Margin="0,0,0,5" Padding="10,9"><TextBlock Text="{Binding}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/></Border></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CountLabel" Foreground="{StaticResource TextBrush}" Text="ВСЕ МОМЕНТЫ" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PlainButton}" Content="✎  Метки / друзья" Padding="10,7" FontSize="11" Margin="0,0,7,0" Click="EditSelected_Click"/>
                                <Button Style="{StaticResource PlainButton}" Content="↗  Открыть" Padding="10,7" FontSize="11" Click="OpenSelected_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="ClipList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="Single" ItemContainerStyle="{StaticResource ClipListItemStyle}" MouseDoubleClick="ClipList_DoubleClick" PreviewMouseRightButtonDown="ClipList_RightClick" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClipItem}">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Width="234" Height="227" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Background="#272832">
                                                <TextBlock Text="▶" Foreground="#72747E" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <Border VerticalAlignment="Bottom" Height="3" Background="{Binding ColorBrush}"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Background="#ED14151A" CornerRadius="5" Padding="7,3">
                                                    <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="White"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" Background="#DC16171A" CornerRadius="5" Padding="7,3">
                                                    <TextBlock Text="{Binding Icon}" FontSize="15"/>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="11,9,11,9">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Game}" Foreground="#F88D55" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailsText}" Foreground="#9698A3" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="▶  Смотреть" Click="OpenSelected_Click"/>
                                    <MenuItem Header="✎  Метки, иконка, друзья" Click="EditSelected_Click"/>
                                    <Separator/>
                                    <MenuItem Header="↗  Показать в Проводнике" Click="RevealSelected_Click"/>
                                    <MenuItem Header="⧉  Скопировать путь" Click="CopyPath_Click"/>
                                    <MenuItem Header="➤  Поделиться файлом..." Click="ShareSelected_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Border x:Name="EmptyClips" Grid.Row="1" Background="#121319" BorderBrush="#34353C" BorderThickness="1" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="▣" FontSize="43" Foreground="#FF7B36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Здесь появятся твои клипы" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,6"/>
                                <TextBlock Text="Перетащи видео в окно или нажми «Добавить видео»" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="2" Text="Двойной клик — просмотр  ·  Правая кнопка — действия  ·  Drag &amp; Drop — импорт" Foreground="#777985" FontSize="10" Margin="0,12,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
            <!-- RULES -->
            <Grid x:Name="RulesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,20,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Content="＋  Добавить игру" Style="{StaticResource OrangeButton}" Click="AddGame_Click" Margin="0,0,0,7"/>
                            <Button Content="Удалить игру из списка" Style="{StaticResource PlainButton}" Click="RemoveGame_Click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ШАБЛОНЫ ИГР" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="4,0,0,13"/>
                        <ListBox x:Name="RulesGameList" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="RulesGameList_SelectionChanged"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="RulesGameTitle" Grid.Row="0" Text="Выбери игру слева" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RulesGamePath" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,20"/>
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ПАПКИ / ТИПЫ МОМЕНТОВ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0" Orientation="Horizontal">
                                <Button Content="＋  Новая папка" Style="{StaticResource OrangeButton}" Click="AddCategory_Click" Margin="0,0,8,0"/>
                                <Button Content="Переименовать" Style="{StaticResource PlainButton}" Click="RenameCategory_Click" Margin="0,0,8,0"/>
                                <Button Content="Убрать из шаблона" Style="{StaticResource PlainButton}" Click="DeleteCategory_Click"/>
                            </StackPanel>
                            <ListBox x:Name="RulesCategoryList" Foreground="White" Background="#1D1E23" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" Padding="6"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Button Content="▣  Создать / дополнить папки выбранной игры" Style="{StaticResource OrangeButton}" Click="CreateFolders_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Изменение шаблона не удаляет файлы. Переименование правила не переименовывает существующую папку." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- FRIENDS -->
            <Grid x:Name="FriendsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="＋  Добавить друга" Style="{StaticResource OrangeButton}" Click="AddFriend_Click"/>
                    <StackPanel><TextBlock Text="Участники твоих моментов" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Привязывай друзей к видео, чтобы находить общие моменты за секунды." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Переименовать" Click="RenameFriend_Click" Style="{StaticResource PlainButton}" Margin="0,0,9,0"/>
                            <Button Content="Убрать друга" Click="DeleteFriend_Click" Style="{StaticResource PlainButton}" Margin="0,0,9,0"/>
                            <Button Content="⇧  Экспорт клипов друга" Click="ExportFriend_Click" Style="{StaticResource OrangeButton}"/>
                        </StackPanel>
                        <ListBox x:Name="FriendsList" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" DisplayMemberPath="Name"/>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- SETTINGS -->
            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="13" Padding="23" Margin="0,0,0,17">
                        <StackPanel>
                            <TextBlock Text="Хранилище видео" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Клипы остаются на диске. Игры хранятся внутри папки ClipVault; ничего не загружается в облако." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
                            <TextBlock Text="Корневая папка ClipVault" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="RootPathLabel" FontSize="15" Margin="0,5,0,16" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource OrangeButton}" Content="Выбрать / изменить папку" Click="ChooseRoot_Click" Margin="0,0,9,0"/>
                                <Button Style="{StaticResource PlainButton}" Content="Открыть папку" Click="OpenRoot_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="13" Padding="23">
                        <StackPanel>
                            <TextBlock Text="Как всё устроено" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="1. Выбери диск или родительскую папку — создадим внутри ClipVault.&#10;2. На вкладке «Игры и папки» создай нужные категории.&#10;3. Импортируй видео, выбери игру, фраг / момент и метки.&#10;4. Добавляй цвета, иконки и друзей к любым найденным видео.&#10;5. Двойным кликом открывай клипы, а через контекстное меню отправляй копию." Foreground="#BABBC5" FontSize="13" LineHeight="24" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <TextBlock Text="Метаданные ClipVault: %LOCALAPPDATA%\ClipVault\library.json. Редактирование тегов не меняет сами видеофайлы." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,13,0,0">
                <TextBlock x:Name="StatusLabel" Text="Готово" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

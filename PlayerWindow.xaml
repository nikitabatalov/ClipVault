<Window x:Class="ClipVault.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Просмотр · ClipVault" Width="980" Height="650" MinWidth="620" MinHeight="420"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#090A0D">
    <Grid Margin="14" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="6,4,6,13">
            <Button DockPanel.Dock="Right" Content="↗  Открыть в плеере Windows" Style="{StaticResource PlainButton}" Click="External_Click"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="Black" CornerRadius="9" ClipToBounds="True">
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="Video_MediaOpened" MediaFailed="Video_MediaFailed"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Content="⏸  Пауза" Style="{StaticResource OrangeButton}" Click="Play_Click" Margin="0,0,14,0"/>
            <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" PreviewMouseDown="Seek_Down" PreviewMouseUp="Seek_Up"/>
            <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,6,0"/>
        </Grid>
    </Grid>
</Window>
